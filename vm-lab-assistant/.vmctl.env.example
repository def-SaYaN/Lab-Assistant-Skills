# Copy to .vmctl.env and fill in. Keep .vmctl.env out of version control.

# --- VMware target (Windows guests) ---
VMX="$HOME/Virtual Machines.localized/MyVM.vmwarevm/MyVM.vmx"
GUEST_USER=Administrator
GUEST_PASS=changeme
VM_TYPE=fusion

# --- SSH target (Linux guests) ---
# SSH_HOST autodetects from VMware Tools when VMX is set and left blank.
#SSH_HOST=192.168.1.50
#SSH_USER=labadmin
#SSH_KEY=~/.ssh/lab_key
#SSH_PORT=22
#SUDO="sudo -n"

# --- Optional overrides ---
#VMRUN=/Applications/VMware Fusion.app/Contents/Public/vmrun
#GUEST_TMP=C:\Windows\Temp\vmctl
#LINUX_TMP=/tmp/vmctl
#ELEV_TASK=VMCTL-Elevated
#ELEV_TIMEOUT=900
